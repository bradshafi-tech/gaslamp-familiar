{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply victorian-adventure --local",
    "db:migrate": "wrangler d1 migrations apply victorian-adventure --remote",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251122.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.167.0"
  }
}
